{
  "name": "dnpk/backend",
  "description": "A simple PHP project using Docker and PHPUnit",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Domain\\Models\\": "Domain/Models/",
      "Domain\\Repositories\\": "Domain/Repositories/",
      "Domain\\Services\\": "Domain/Services/",
      "Utils\\": "utils/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
